DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/aerofare
# Generate with: openssl rand -hex 32  (HS256 needs at least 32 bytes)
SECRET_KEY=change-me
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRY_MINUTES=30
REDIS_URL=redis://localhost:6379/0
# Optional. pretty = coloured dev logs, json = one object per line (CI, Docker)
LOG_LEVEL=INFO
LOG_FORMAT=pretty
# Optional. Where booking emails go. Defaults match Mailpit (web UI on :8025).
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Aerofare <noreply@aerofare.local>
# Optional. Base address of the React app, used in password reset links.
FRONTEND_URL=http://localhost:5173
